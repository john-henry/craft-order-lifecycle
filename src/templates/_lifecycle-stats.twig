{# =========================================================================
   Order Lifecycle Metrics
   Card summary of the order's key conversion metrics (time to convert,
   checkout duration, cart activity, customer type) plus a started/completed
   summary bar with request origin.
   ========================================================================= #}
<div class="lifecycle-stats">
   {% set cartCreated = null %}
   {% set firstCartActivity = null %}
   {% set checkoutStarted = null %}
   {% set orderCompleted = null %}
   {% set orderPaid = null %}
   {% set itemsAdded = 0 %}
   {% set itemsRemoved = 0 %}
   {% set firstIp = null %}

   {% for log in logs %}
      {% if log.type == 'cartCreated' and cartCreated is null %}
         {% set cartCreated = log.dateCreated|date('U') %}
         {% set firstCartActivity = log.dateCreated|date('U') %}
      {% endif %}

      {% if firstCartActivity is null and (log.type == 'lineItemAdded' or log.type == 'lineItemRemoved' or log.type == 'cartUpdated') %}
         {% set firstCartActivity = log.dateCreated|date('U') %}
      {% endif %}

      {% if log.type == 'checkoutStarted' and checkoutStarted is null %}
         {% set checkoutStarted = log.dateCreated|date('U') %}
      {% endif %}

      {% if log.type == 'orderCompleted' and orderCompleted is null %}
         {% set orderCompleted = log.dateCreated|date('U') %}
      {% endif %}

      {% if log.type == 'orderPaid' and orderPaid is null %}
         {% set orderPaid = log.dateCreated|date('U') %}
      {% endif %}

      {% if log.type == 'lineItemAdded' %}
         {% set itemsAdded = itemsAdded + 1 %}
      {% endif %}
      {% if log.type == 'lineItemRemoved' %}
         {% set itemsRemoved = itemsRemoved + 1 %}
      {% endif %}

      {% if firstIp is null and log.ip is defined and log.ip %}
         {% set firstIp = log.ip %}
      {% endif %}
   {% endfor %}

   <div class="lifecycle-metric-cards">
      {% if firstCartActivity and orderCompleted %}
         <div class="lifecycle-metric-card">
            <div class="lifecycle-metric-label">{{ 'Time to Convert'|t('order-lifecycle') }}</div>
            <div class="lifecycle-metric-value">
               {% set duration = orderCompleted - firstCartActivity %}
               {% if duration > 0 %}
                  {% set hours = (duration / 3600)|round(0, 'floor') %}
                  {% set minutes = ((duration % 3600) / 60)|round(0, 'floor') %}
                  {% set seconds = duration % 60 %}
                  {% if hours > 0 %}
                     {{ hours }}h {{ minutes }}m
                  {% elseif minutes > 0 %}
                     {{ minutes }}m {{ seconds }}s
                  {% else %}
                     {{ seconds }}s
                  {% endif %}
               {% else %}
                  &lt; 1s
               {% endif %}
            </div>
            <div class="lifecycle-metric-sub">{{ 'first activity → completed'|t('order-lifecycle') }}</div>
         </div>
      {% endif %}

      {% if checkoutStarted and orderPaid %}
         <div class="lifecycle-metric-card">
            <div class="lifecycle-metric-label">{{ 'Checkout Duration'|t('order-lifecycle') }}</div>
            <div class="lifecycle-metric-value">
               {% set duration = orderPaid - checkoutStarted %}
               {% if duration > 0 %}
                  {% set minutes = (duration / 60)|round(0, 'floor') %}
                  {% set seconds = duration % 60 %}
                  {% if minutes > 0 %}
                     {{ minutes }}m {{ seconds }}s
                  {% else %}
                     {{ seconds }}s
                  {% endif %}
               {% else %}
                  &lt; 1s
               {% endif %}
            </div>
            <div class="lifecycle-metric-sub">{{ 'started → paid'|t('order-lifecycle') }}</div>
         </div>
      {% endif %}

      {% if itemsAdded > 0 or itemsRemoved > 0 %}
         <div class="lifecycle-metric-card">
            <div class="lifecycle-metric-label">{{ 'Cart Items'|t('order-lifecycle') }}</div>
            <div class="lifecycle-metric-value">
               <span class="success">{{ itemsAdded }}</span> {{ 'added'|t('order-lifecycle') }}
            </div>
            <div class="lifecycle-metric-sub">
               {{ itemsRemoved }} {{ 'removed'|t('order-lifecycle') }}
            </div>
         </div>
      {% endif %}

      {% if order is defined %}
         {% set previousOrders = craft.orderLifecycle.stats.getPreviousOrderCount(order) %}
         <div class="lifecycle-metric-card">
            <div class="lifecycle-metric-label">{{ 'Customer'|t('order-lifecycle') }}</div>
            <div class="lifecycle-metric-value">
               {{ previousOrders > 0 ? 'Returning'|t('order-lifecycle') : 'New'|t('order-lifecycle') }}
            </div>
            <div class="lifecycle-metric-sub">
               {% if previousOrders > 0 %}
                  {{ previousOrders }} {{ previousOrders == 1 ? 'previous order'|t('order-lifecycle') : 'previous orders'|t('order-lifecycle') }}
               {% else %}
                  {{ 'No previous orders'|t('order-lifecycle') }}
               {% endif %}
            </div>
         </div>
      {% endif %}
   </div>

   {% if cartCreated or orderCompleted %}
      <div class="lifecycle-summary-bar">
         <div class="lifecycle-summary-point">
            <span class="lifecycle-summary-label">{{ 'Started'|t('order-lifecycle') }}</span>
            <span class="lifecycle-summary-datetime">{{ cartCreated ? cartCreated|datetime('medium') : '-' }}</span>
         </div>
         <div class="lifecycle-summary-connector"></div>
         <div class="lifecycle-summary-point">
            <span class="lifecycle-summary-label">{{ 'Completed'|t('order-lifecycle') }}</span>
            <span class="lifecycle-summary-datetime">{{ orderCompleted ? orderCompleted|datetime('medium') : '-' }}</span>
         </div>
         <div class="lifecycle-summary-origin">
            {{ 'Origin'|t('order-lifecycle') }}: {{ 'Web'|t('order-lifecycle') }}{% if firstIp %} · {{ 'IP'|t('order-lifecycle') }} {{ firstIp }}{% endif %}
         </div>
      </div>
   {% endif %}
</div>
