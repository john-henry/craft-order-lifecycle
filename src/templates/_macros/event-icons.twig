{#
Event Icons Macro
Usage: {{ icons.eventIcon(row.type, transactions, row.snapshot) }}
#}

{% macro eventIcon(eventType, transactions = null, snapshot = null) %}
    {% if eventType starts with 'cart' %}
        <span class="status-icon cart">
		 <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
		   <path d="M1.75 1.002a.75.75 0 1 0 0 1.5h1.835l1.24 5.113A3.752 3.752 0 0 0 2 11.25c0 .414.336.75.75.75h10.5a.75.75 0 0 0 0-1.5H3.628A2.25 2.25 0 0 1 5.75 9h6.5a.75.75 0 0 0 .73-.578l.846-3.595a.75.75 0 0 0-.578-.906 44.118 44.118 0 0 0-7.996-.91l-.348-1.436a.75.75 0 0 0-.73-.573H1.75ZM5 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM13 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"/>
		 </svg>
		</span>
    {% elseif eventType starts with 'lineItem' %}
        <span class="status-icon item">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
				<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
				<polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
				<line x1="12" y1="22.08" x2="12" y2="12"></line>
			</svg>
		</span>
    {% elseif eventType == 'orderCompleted' %}
        <span class="status-icon order-completed">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
				<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
				<line x1="4" y1="22" x2="4" y2="15"></line>
			</svg>
		</span>
    {% elseif eventType starts with 'order' %}
        <span class="status-icon order">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
				<path d="M9 11l3 3L22 4"></path>
				<path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
			</svg>
		</span>
    {% elseif eventType starts with 'payment' %}
        {% set snapshotData = snapshot|json_decode %}
        {% set payloadTransactionId = snapshotData.payload.transactionId ?? null %}
        {% set transactionStatus = null %}
        
        {% if payloadTransactionId and transactions %}
            {% for transaction in transactions %}
                {% if transaction.id == payloadTransactionId %}
                    {% set transactionStatus = transaction.status %}
                {% endif %}
            {% endfor %}
        {% endif %}
        
        {% if transactionStatus == 'success' %}
            <span class="status-icon payment success">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
					<line x1="12" y1="1" x2="12" y2="23"></line>
					<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
				</svg>
			</span>
        {% elseif transactionStatus == 'failed' %}
            <span class="status-icon payment error">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
					<line x1="12" y1="1" x2="12" y2="23"></line>
					<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
				</svg>
			</span>
        {% else %}
            <span class="status-icon payment">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
					<line x1="12" y1="1" x2="12" y2="23"></line>
					<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
				</svg>
			</span>
        {% endif %}
    {% elseif eventType starts with 'shipping' or eventType starts with 'billing' %}
        <span class="status-icon address">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
				<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
				<circle cx="12" cy="10" r="3"></circle>
			</svg>
		</span>
    {% elseif eventType == 'emailSent' or eventType == 'emailFailed' %}
        <span class="status-icon email {% if eventType == 'emailFailed' %}error{% endif %}">
			<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
				<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
				<polyline points="22,6 12,13 2,6"></polyline>
			</svg>
		</span>
    {% elseif eventType == 'customerSet' %}
        <span class="status-icon customer-set">
		 <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
  <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM12.735 14c.618 0 1.093-.561.872-1.139a6.002 6.002 0 0 0-11.215 0c-.22.578.254 1.139.872 1.139h9.47Z"/>
</svg>
		</span>
    {% elseif eventType == 'statusChanged' %}
        <span class="status-icon status-update">
			<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
				<polyline points="1 4 1 10 7 10"></polyline>
				<polyline points="23 20 23 14 17 14"></polyline>
				<path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
			</svg>
		</span>
    {% elseif eventType == 'checkoutStarted' %}
        <span class="status-icon checkout">
		 <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
			<path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
			<line x1="3" y1="6" x2="21" y2="6"></line>
			<path d="M16 10a4 4 0 0 1-8 0"></path>
		 </svg>
	  </span>
    {% elseif eventType starts with 'coupon' %}
        <span class="status-icon coupon">
		 <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
			<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
			<circle cx="12" cy="12" r="1"></circle>
			<circle cx="12" cy="8" r="1"></circle>
			<circle cx="12" cy="16" r="1"></circle>
		 </svg>
	  </span>
    {% else %}
        <span class="status-icon default"></span>
    {% endif %}
{% endmacro %}
