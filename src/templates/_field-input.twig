
{% import 'order-lifecycle/_macros/status-badges.twig' as badges %}
{% import 'order-lifecycle/_macros/event-icons.twig' as icons %}
<div class="order-lifecycle-field">
   
   {% if logs|length %}
   
   {% if craft.app.plugins.getPlugin('order-lifecycle').settings.showLifecycleStats %}
	  {{ include('order-lifecycle/_lifecycle-stats.twig') }}
   {% endif %}

   {% if craft.app.plugins.getPlugin('order-lifecycle').settings.anthropicApiKey %}
   {% set savedInsights = logs|filter(l => l.type == 'aiInsights')|first %}
   {% set structuredInsights = savedInsights ? craft.orderLifecycle.aiInsights.decodeStructuredInsights(savedInsights.message ?? null) : null %}
   {% set sparkleSvgPath -%}
      <path d="M7.657 6.247c.11-.33.576-.33.686 0l.645 1.937a2.89 2.89 0 0 0 1.829 1.828l1.936.645c.33.11.33.576 0 .686l-1.937.645a2.89 2.89 0 0 0-1.828 1.829l-.645 1.936a.361.361 0 0 1-.686 0l-.645-1.937a2.89 2.89 0 0 0-1.828-1.828l-1.937-.645a.361.361 0 0 1 0-.686l1.937-.645a2.89 2.89 0 0 0 1.828-1.828l.645-1.937ZM3.794 1.148a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387A1.734 1.734 0 0 0 4.593 5.69l-.387 1.162a.217.217 0 0 1-.412 0L3.407 5.69A1.734 1.734 0 0 0 2.31 4.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387A1.734 1.734 0 0 0 3.407 2.31l.387-1.162ZM10.863.099a.145.145 0 0 1 .274 0l.258.774c.115.346.386.617.732.732l.774.258a.145.145 0 0 1 0 .274l-.774.258a1.156 1.156 0 0 0-.732.732l-.258.774a.145.145 0 0 1-.274 0l-.258-.774a1.156 1.156 0 0 0-.732-.732L9.1 2.137a.145.145 0 0 1 0-.274l.774-.258c.346-.115.617-.386.732-.732L10.863.1Z"/>
   {%- endset %}
   <div class="lifecycle-ai-section" data-order-id="{{ order.id ?? '' }}">
      <div class="lifecycle-analysis-card" data-state="{{ savedInsights ? 'ready' : 'empty' }}">
         <div class="lifecycle-analysis-card-header">
            <div class="lifecycle-analysis-icon">
               <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="18" height="18" aria-hidden="true">{{ sparkleSvgPath|raw }}</svg>
            </div>
            <div class="lifecycle-analysis-heading">
               <div class="lifecycle-analysis-title">
                  {{ 'Order analysis'|t('order-lifecycle') }}
                  <span class="lifecycle-analysis-status{% if not savedInsights %} hidden{% endif %}">
                     <span class="lifecycle-analysis-status-dot"></span>{{ 'Up to date'|t('order-lifecycle') }}
                  </span>
               </div>
               <div class="lifecycle-analysis-subtitle{% if savedInsights %} hidden{% endif %}">
                  {{ "Summarize this order's lifecycle, payments and anomalies with AI."|t('order-lifecycle') }}
               </div>
            </div>
            <div class="lifecycle-analysis-card-actions">
               <span class="lifecycle-ai-meta light{% if not savedInsights %} hidden{% endif %}">
                  {% if savedInsights %}{{ 'Generated'|t('order-lifecycle') }} {{ savedInsights.dateCreated|datetime('short') }}{% endif %}
               </span>
               <button type="button" class="btn lifecycle-ai-btn">
                  {{ (savedInsights ? 'Refresh' : 'Generate insights')|t('order-lifecycle') }}
               </button>
            </div>
         </div>

         <div class="lifecycle-ai-result{% if not savedInsights %} hidden{% endif %}" aria-live="polite">
            {% if order is defined and order %}
               <div class="lifecycle-analysis-summary">
                  {%- set customerLabel = order.getCustomer() ? 'Registered'|t('order-lifecycle') : 'Guest'|t('order-lifecycle') -%}
                  {%- set statusLabel = order.isCompleted ? 'Completed'|t('order-lifecycle') : (order.getOrderStatus()?.name ?? 'Pending'|t('order-lifecycle')) -%}
                  {%- set summarySegments = [
                     'Order #{reference}'|t('order-lifecycle', { reference: order.reference ?? order.id }),
                     order.currency,
                     '{customerLabel} Customer'|t('order-lifecycle', { customerLabel: customerLabel }),
                     statusLabel,
                  ] -%}
                  {{- summarySegments|join(' | ') -}}
               </div>
            {% endif %}
            <div class="lifecycle-ai-content">
               {% if structuredInsights %}
                  {% include 'order-lifecycle/_includes/ai-insight-structured.twig' with { structured: structuredInsights } only %}
               {% else %}
                  {{ (savedInsights.message ?? '')|e|md }}
               {% endif %}
            </div>
         </div>
      </div>
   </div>
   {% endif %}

	  {% set filterPills = [
		 { value: 'all', label: 'All events'|t('order-lifecycle') },
		 { value: 'cart', label: 'Cart'|t('order-lifecycle') },
		 { value: 'lineItems', label: 'Line items'|t('order-lifecycle') },
		 { value: 'coupons', label: 'Coupons'|t('order-lifecycle') },
		 { value: 'customer', label: 'Customer'|t('order-lifecycle') },
		 { value: 'addresses', label: 'Address'|t('order-lifecycle') },
		 { value: 'shipping', label: 'Shipping'|t('order-lifecycle') },
		 { value: 'payment', label: 'Payments'|t('order-lifecycle') },
		 { value: 'order', label: 'Order'|t('order-lifecycle') },
		 { value: 'email', label: 'Emails'|t('order-lifecycle') },
	  ] %}

	  {# Only show a pill when this order actually has an event in that category #}
	  {% set presentPills = [] %}
	  {% for row in timeline %}
		 {% if row.pill not in presentPills %}
			{% set presentPills = presentPills|merge([row.pill]) %}
		 {% endif %}
	  {% endfor %}

	  <div class="lifecycle-timeline-controls">
		 <div class="lifecycle-filter-pills" role="group" aria-label="{{ 'Filter events'|t('order-lifecycle') }}">
			{% for pill in filterPills %}
			   {% if pill.value == 'all' or pill.value in presentPills %}
				  <button type="button" class="lifecycle-filter-pill{% if loop.first %} active{% endif %}" data-pill="{{ pill.value }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}">{{ pill.label }}</button>
			   {% endif %}
			{% endfor %}
		 </div>
		 <button type="button" class="lifecycle-sort-toggle" data-sort="desc">
			<span class="lifecycle-sort-label">{{ 'Newest first'|t('order-lifecycle') }}</span>
			<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.25a.75.75 0 0 1 .75.75v8.69l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 1 1 1.06-1.06l2.22 2.22V2A.75.75 0 0 1 4 1.25Zm8 13.5a.75.75 0 0 1-.75-.75V5.31L9.03 7.53a.75.75 0 0 1-1.06-1.06l3.5-3.5a.75.75 0 0 1 1.06 0l3.5 3.5a.75.75 0 1 1-1.06 1.06L12.75 5.31V14a.75.75 0 0 1-.75.75Z"/></svg>
		 </button>
	  </div>

	  <div class="visually-hidden lifecycle-timeline-status" role="status" aria-live="polite"></div>

	  <div class="lifecycle-timeline">
		 {% for row in timeline %}
			<div class="lifecycle-event" data-pill="{{ row.pill }}" data-date="{{ row.dateCreated|date('Y-m-d') }}">
			   <details class="lifecycle-event-details">
				  <summary class="lifecycle-event-summary">
					 <div class="event-icon">
						{{ icons.eventIcon(row.type, transactions, row.snapshot) }}
					 </div>
					 <div class="lifecycle-event-main">
						{% set snapshotData = row.snapshot|json_decode %}
						{% set attemptCount = snapshotData.payload.attempt ?? null %}

						<strong>{{ row.type|replace({'/([A-Z])/': ' $1'})|trim|title }}</strong>
						{% if attemptCount and attemptCount > 1 %}
						   <span class="attempt-count">({{ attemptCount }} attempts)</span>
						{% endif %}
						{% set matchingPaymentTransaction = null %}
						{% if row.type starts with 'payment' %}
						   {% set snapshotData = row.snapshot|json_decode %}
						   {% set payloadTransactionId = snapshotData.payload.transactionId ?? null %}
						   {% set transactionStatus = null %}

						   {% if payloadTransactionId %}
							  {% for transaction in transactions %}
								 {% if transaction.id == payloadTransactionId %}
									{% set transactionStatus = transaction.status %}
									{% set matchingPaymentTransaction = transaction %}
								 {% endif %}
							  {% endfor %}
						   {% endif %}

						   {# Only show a badge when the status isn't already implied by the title (e.g. "Payment Processed") - failures/pending genuinely add information #}
						   {% if transactionStatus and transactionStatus != 'success' %}
							  {{ badges.statusBadge(transactionStatus|title|t('order-lifecycle'), transactionStatus) }}
						   {% endif %}
						{% elseif row.type == 'statusChanged' %}
						   {% set snapshotData = row.snapshot|json_decode %}
						   {% set newStatusId = snapshotData.payload.newStatusId ?? null %}
						   {% if newStatusId and statuses is defined %}
							  {% for status in statuses %}
								 {% if status.id == newStatusId %}
									{{ badges.statusBadge(status.name, status.color) }}
								 {% endif %}
							  {% endfor %}
						   {% endif %}
						{% endif %}
						{% if row.message %}
						   <span class="lifecycle-event-message">{{ row.message|raw }}</span>
						{% endif %}
					 </div>
					 <div class="lifecycle-event-meta">
						{% if row.deltaSeconds is not null %}
						   <span class="lifecycle-event-delta">+{% if row.deltaSeconds >= 60 %}{{ (row.deltaSeconds / 60)|round(0, 'floor') }}m {{ row.deltaSeconds % 60 }}s{% else %}{{ row.deltaSeconds }}s{% endif %} {{ 'since previous'|t('order-lifecycle') }}</span>
						{% endif %}
						<span class="lifecycle-event-date hidden">{{ row.dateCreated|date('M j, Y') }}</span>
						<span class="lifecycle-event-time">{{ row.dateCreated|time('short') }}</span>
						<svg class="lifecycle-event-chevron" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/></svg>
					 </div>
				  </summary>

				  <div class="lifecycle-event-body">
					 {% if row.snapshot %}
						{# gateway/transaction status live on the matched Transaction, not the
						   snapshot, so payment events get them appended as revealed facts
						   (null -> value). refunds show amount/note instead, since the
						   matched transaction there is the original charge, not the refund #}
						{% set paymentChanges = [] %}
						{% if row.type == 'paymentRefunded' %}
						   {% set refundAmount = snapshotData.payload.amount ?? null %}
						   {% set refundNote = snapshotData.payload.note ?? null %}
						   {% if refundAmount is not null %}
							  {% set paymentChanges = paymentChanges|merge([
								 { label: 'Amount Refunded'|t('order-lifecycle'), from: null, to: refundAmount|currency(snapshotData.payload.currency ?? null) },
							  ]) %}
						   {% endif %}
						   {% if refundNote %}
							  {% set paymentChanges = paymentChanges|merge([
								 { label: 'Refund Note'|t('order-lifecycle'), from: null, to: refundNote },
							  ]) %}
						   {% endif %}
						{% elseif matchingPaymentTransaction %}
						   {% set paymentChanges = [
							  { label: 'Gateway'|t('order-lifecycle'), from: null, to: matchingPaymentTransaction.gateway.handle ?? null },
							  { label: 'Transaction Status'|t('order-lifecycle'), from: null, to: matchingPaymentTransaction.status },
						   ] %}
						{% endif %}
						{% set allChanges = row.orderChanges|merge(paymentChanges) %}

						<div class="lifecycle-diff-header-row">
						   <div class="lifecycle-diff-header">{{ 'Changes since previous event'|t('order-lifecycle') }}</div>
						   <button type="button" class="lifecycle-snapshot-toggle" aria-expanded="false">
							  <span class="lifecycle-snapshot-toggle-text">{{ 'View full snapshot'|t('order-lifecycle') }}</span>
						   </button>
						</div>

						{% if allChanges|length %}
						   <table class="lifecycle-diff-table">
							  <caption class="visually-hidden">{{ 'Changes since previous event'|t('order-lifecycle') }}</caption>
							  <thead>
								 <tr>
									<th scope="col">{{ 'Field'|t('order-lifecycle') }}</th>
									<th scope="col">{{ 'Previous value'|t('order-lifecycle') }}</th>
									<th scope="col" class="visually-hidden">{{ 'Changed to'|t('order-lifecycle') }}</th>
									<th scope="col">{{ 'New value'|t('order-lifecycle') }}</th>
								 </tr>
							  </thead>
							  <tbody>
								 {% for change in allChanges %}
									<tr>
									   <th scope="row" class="lifecycle-diff-field">{{ change.label ?? change.field }}</th>
									   <td class="lifecycle-diff-from"><s>{{ change.from|json_encode }}</s></td>
									   <td class="lifecycle-diff-arrow" aria-hidden="true">&rarr;</td>
									   <td class="lifecycle-diff-to">{{ change.to|json_encode }}</td>
									</tr>
								 {% endfor %}
							  </tbody>
						   </table>
						{% else %}
						   <p class="lifecycle-diff-empty">{{ 'No field changes recorded for this event.'|t('order-lifecycle') }}</p>
						{% endif %}
					 {% endif %}

					 {% if row.snapshot %}
						<div class="snapshot-content hidden">
						   {% set snapshotData = row.snapshot|json_decode %}
						   {% if row.type == 'customerSet' %}
							  <pre class="order-lifecycle-pre">{{ snapshotData.customer|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
						   {% elseif row.type == 'emailSent' or row.type == 'emailFailed' %}
							  <pre class="order-lifecycle-pre">{{ snapshotData.payload|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
						   {% elseif row.type == 'statusChanged' %}
							  <pre class="order-lifecycle-pre">{{ snapshotData.payload|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
						   {% elseif row.type == 'lineItemAdded' or row.type == 'lineItemRemoved' %}
							  <pre class="order-lifecycle-pre">{{ snapshotData.lineItems|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
						   {% elseif row.type  starts with 'coupon' %}
							  <pre class="order-lifecycle-pre">{{ snapshotData.discounts|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
						   {% elseif row.type starts with 'payment' %}
						   {% set payloadTransactionId = snapshotData.payload.transactionId ?? null %}
						   {% if payloadTransactionId %}
							  {% set matchingTransaction = null %}
							  {% set refundTransactions = [] %}
							  {% for transaction in transactions %}
								 {% if transaction.id == payloadTransactionId %}
									{% set matchingTransaction = transaction %}
								 {% endif %}
							  {% endfor %}

							  {% if matchingTransaction and row.type == 'paymentRefunded' %}
								 {% for transaction in transactions %}
									{% if transaction.parentId == matchingTransaction.id %}
									   {% set refundTransactions = refundTransactions|merge([transaction]) %}
									{% endif %}
								 {% endfor %}
							  {% endif %}

							  {% if matchingTransaction %}


								 {% if refundTransactions|length %}
									<h4 style="margin-top: 1rem;">{{ 'Refund Transactions'|t('order-lifecycle') }}</h4>
									{% for refundTransaction in refundTransactions %}
									   {% set refundTransactionData = {
										  id: refundTransaction.id,
										  type: refundTransaction.type,
										  status: refundTransaction.status,
										  amount: refundTransaction.amount,
										  currency: refundTransaction.currency,
										  paymentAmount: refundTransaction.paymentAmount,
										  paymentCurrency: refundTransaction.paymentCurrency,
										  hash: refundTransaction.hash,
										  reference: refundTransaction.reference,
										  code: refundTransaction.code,
										  message: refundTransaction.message,
										  note: refundTransaction.note,
										  response: refundTransaction.response,
										  gatewayId: refundTransaction.gatewayId,
										  orderId: refundTransaction.orderId,
										  parentId: refundTransaction.parentId,
										  userId: refundTransaction.userId,
										  dateCreated: refundTransaction.dateCreated|date('c'),
										  dateUpdated: refundTransaction.dateUpdated|date('c'),
									   } %}
									   <pre class="order-lifecycle-pre">{{ refundTransactionData|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
									{% endfor %}
									{% else %}
									   <h4 style="margin-top: 1rem;">{{ 'Transaction Details'|t('order-lifecycle') }}</h4>
									   {% set transactionData = {
										  id: matchingTransaction.id,
										  type: matchingTransaction.type,
										  status: matchingTransaction.status,
										  amount: matchingTransaction.amount,
										  currency: matchingTransaction.currency,
										  paymentAmount: matchingTransaction.paymentAmount,
										  paymentCurrency: matchingTransaction.paymentCurrency,
										  hash: matchingTransaction.hash,
										  reference: matchingTransaction.reference,
										  code: matchingTransaction.code,
										  message: matchingTransaction.message,
										  note: matchingTransaction.note,
										  response: matchingTransaction.response,
										  gatewayId: matchingTransaction.gatewayId,
										  orderId: matchingTransaction.orderId,
										  parentId: matchingTransaction.parentId,
										  userId: matchingTransaction.userId,
										  dateCreated: matchingTransaction.dateCreated|date('c'),
										  dateUpdated: matchingTransaction.dateUpdated|date('c'),
									   } %}
									   <pre class="order-lifecycle-pre">{{ transactionData|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
								 {% endif %}
							  {% else %}
								 <p class="light">{{ 'Transaction #'|t('order-lifecycle') }}{{ payloadTransactionId }} {{ 'not found.'|t('order-lifecycle') }}</p>
							  {% endif %}
						   {% endif %}
						   {% else %}
							  {# For all other events, show the full snapshot #}
							  <pre class="order-lifecycle-pre">{{ snapshotData|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
						   {% endif %}
						</div>
					 {% endif %}
				  </div>
			   </details>
			</div>
		 {% endfor %}
	  </div>

   {% else %}
	  <div class="empty-state">
		 <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<circle cx="12" cy="12" r="10"></circle>
			<polyline points="12 6 12 12 16 14"></polyline>
		 </svg>
		 <h3>{{ 'No Order lifecycle events yet'|t('order-lifecycle') }}</h3>
		 <p>{{ 'Events will be recorded as customers interact with this order.'|t('order-lifecycle') }}</p>
	  </div>
	  
   {% endif %}
</div>
