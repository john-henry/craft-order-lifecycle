{% extends '_layouts/cp' %}

{% set selectedSubnavItem = 'insights' %}
{% set title = 'AI Insights'|t('order-lifecycle') %}
{% set crumbs = [
    { label: 'Order Lifecycle'|t('order-lifecycle'), url: cpUrl('order-lifecycle') }
] %}

{% do view.registerAssetBundle('johnhenry\\orderlifecycle\\assets\\OrderLifecycleAsset') %}

{% block content %}
    <p class="ol-ai-page-intro">{{ 'Get an AI-written summary of your store\'s conversion, payments, email reliability and anomalies. Pick a period, add any context or a specific question for Claude, then generate the report.'|t('order-lifecycle') }}</p>

{% if not hasApiKey %}
    <div class="readable">
        <p>
            {{ 'No Anthropic API key configured. Add one in Settings → Order Lifecycle to enable AI Insights.'|t('order-lifecycle') }}
            <a href="{{ url('settings/plugins/order-lifecycle') }}">{{ 'Settings'|t('app') }}</a>
        </p>
    </div>
{% else %}
    <div class="ol-ai-widget lifecycle-analysis-card" data-days="30" data-state="{{ saved ? 'ready' : 'empty' }}">

        {% if saved %}
            {% set ageSeconds = now|date('U') - saved.generatedAt|date('U') %}
            {% if ageSeconds > 604800 %}
                <div class="ol-ai-stale-notice">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="14" height="14" aria-hidden="true"><path fill-rule="evenodd" d="M6.701 2.25c.577-1 2.02-1 2.598 0l5.196 9a1.5 1.5 0 0 1-1.299 2.25H2.804a1.5 1.5 0 0 1-1.3-2.25l5.197-9ZM8 4a.75.75 0 0 1 .75.75v3a.75.75 0 1 1-1.5 0v-3A.75.75 0 0 1 8 4Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/></svg>
                    {{ 'These insights are more than a week old. Consider regenerating.'|t('order-lifecycle') }}
                </div>
            {% endif %}

            <div class="ol-ai-widget-result">
                <div class="ol-ai-widget-text ol-ai-markdown" data-raw="{{ saved.insights|e('html_attr') }}">{{ saved.insights|nl2br }}</div>
                <div class="ol-ai-widget-meta">
                    {{ 'Generated'|t('order-lifecycle') }} {{ saved.generatedAt|datetime('short') }}
                    &middot;
                    {% if saved.days == 0 %}
                        {{ 'All time'|t('order-lifecycle') }}
                    {% else %}
                        {{ 'Last {days} days'|t('order-lifecycle', {days: saved.days}) }}
                    {% endif %}
                    <button type="button" class="ol-ai-copy-btn btn small" data-copy="{{ saved.insights|e('html_attr') }}">{{ 'Copy'|t('order-lifecycle') }}</button>
                </div>
            </div>
        {% else %}
            <div class="ol-ai-widget-empty">
                <p>{{ 'No insights generated yet. Click the button below to analyse your store.'|t('order-lifecycle') }}</p>
            </div>
        {% endif %}

        <div class="ol-ai-context-wrap">
            <label class="ol-ai-context-label" for="ol-ai-context">{{ 'Context / Notes'|t('order-lifecycle') }}</label>
            <textarea id="ol-ai-context" class="text ol-ai-context-notes" rows="2" placeholder="{{ 'Additional context or specific questions for Claude to consider...'|t('order-lifecycle') }}"></textarea>
        </div>

        <div class="ol-ai-widget-actions">
            <div class="ol-ai-dashboard-period">
                <label for="ol-ai-days-select">{{ 'Period'|t('order-lifecycle') }}</label>
                <div class="select">
                    <select id="ol-ai-days-select">
                        {% for d in [7, 14, 30, 60, 90] %}
                            <option value="{{ d }}"{% if d == 30 %} selected{% endif %}>
                                {{ d ~ ' ' ~ 'days'|t('order-lifecycle') }}
                            </option>
                        {% endfor %}
                        <option value="0">{{ 'All time'|t('order-lifecycle') }}</option>
                    </select>
                </div>
            </div>

            <button type="button" class="btn ol-ai-widget-btn">
                {{ (saved ? 'Refresh Insights' : 'Generate Insights')|t('order-lifecycle') }}
            </button>
            <span class="ol-ai-widget-spinner spinner hidden"></span>
        </div>

        <div class="ol-ai-widget-error hidden" role="alert"></div>

    </div>
{% endif %}
{% endblock %}
