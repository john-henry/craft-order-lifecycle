{% extends '_layouts/cp' %}

{% set selectedSubnavItem = 'overview' %}
{% set title = 'Overview'|t('order-lifecycle') %}
{% set crumbs = [
    { label: 'Order Lifecycle'|t('order-lifecycle'), url: cpUrl('order-lifecycle') }
] %}

{% do view.registerAssetBundle('johnhenry\\orderlifecycle\\assets\\OrderLifecycleAsset') %}
{% import _self as macros %}

{% macro trend(delta, upIsGood) %}{% if delta is not null %}{% set abs = delta|abs %}{% if abs < 1 %}<span class="ol-trend-chip ol-trend-neutral">→ &lt;1%</span>{% else %}{% set isGood = (delta > 0 and upIsGood) or (delta < 0 and not upIsGood) %}<span class="ol-trend-chip {{ isGood ? 'ol-trend-up' : 'ol-trend-down' }}">{{ delta > 0 ? '↑' : '↓' }} {{ abs }}%</span>{% endif %}{% endif %}{% endmacro %}

{% block actionButton %}
<form method="get" action="{{ cpUrl('order-lifecycle') }}">
    <div class="btngroup">
        {% for d in [7, 14, 30, 60, 90] %}
            <button type="submit" name="days" value="{{ d }}" class="btn{% if days == d %} active{% endif %}">
                {{ d ~ ' ' ~ 'days'|t('order-lifecycle') }}
            </button>
        {% endfor %}
        <button type="submit" name="days" value="0" class="btn{% if days == 0 %} active{% endif %}">
            {{ 'All time'|t('order-lifecycle') }}
        </button>
    </div>
</form>
{% endblock %}

{% block content %}
<div class="order-lifecycle-dashboard">

    {# ── Alert banners ─────────────────────────────────────────────────────── #}
    {% set alerts = [] %}

    {% if stats.uniqueOrders == 0 and stats.days > 0 %}
        {% set alerts = alerts|merge([{
            level: 'warning',
            icon: '⚠',
            message: 'No orders tracked in this period. Lifecycle logging may not be active.'|t('order-lifecycle')
        }]) %}
    {% endif %}

    {% if stats.abandonmentRate > 75 and stats.cartsCreated >= 5 %}
        {% set alerts = alerts|merge([{
            level: 'warning',
            icon: '⚠',
            message: 'Abandonment rate is {rate}% - above the 75% threshold. Consider reviewing the checkout flow.'|t('order-lifecycle', {rate: stats.abandonmentRate})
        }]) %}
    {% endif %}

    {% if (stats.emailsSent + stats.emailsFailed) >= 5 and stats.emailSuccessRate < 90 %}
        {% set alerts = alerts|merge([{
            level: 'danger',
            icon: '⚠',
            message: 'Email success rate is {rate}% ({failed} failed). Check your email provider configuration.'|t('order-lifecycle', {rate: stats.emailSuccessRate, failed: stats.emailsFailed})
        }]) %}
    {% endif %}

    {% if stats.avgPaymentAttempts > 2 and stats.ordersCompleted >= 5 %}
        {% set alerts = alerts|merge([{
            level: 'warning',
            icon: '⚠',
            message: 'Customers are averaging {n} payment retries on failed orders. Check your payment gateway.'|t('order-lifecycle', {n: stats.avgPaymentAttempts})
        }]) %}
    {% endif %}

    {% if alerts|length > 0 %}
        <div class="ol-alerts">
            {% for alert in alerts %}
                <div class="ol-alert ol-alert-{{ alert.level }}">
                    <span class="ol-alert-icon">{{ alert.icon }}</span>
                    <span>{{ alert.message }}</span>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {# ── Stat grid ─────────────────────────────────────────────────────────── #}
    <div class="ol-stat-grid">

        <div class="ol-stat-card">
            <div class="ol-stat-label">{{ 'Total Events'|t('order-lifecycle') }}</div>
            <div class="ol-stat-value-row">
                <span class="ol-stat-value">{{ stats.totalLogs|number_format }}</span>
                {{ macros.trend(stats.trends.totalLogs ?? null, true) }}
            </div>
            <div class="ol-stat-sub">{{ 'Across {count} orders'|t('order-lifecycle', {count: stats.uniqueOrders}) }}</div>
        </div>

        <div class="ol-stat-card">
            <div class="ol-stat-label">{{ 'Avg. Events/Order'|t('order-lifecycle') }}</div>
            <div class="ol-stat-value-row">
                <span class="ol-stat-value">{{ stats.avgLogsPerOrder }}</span>
            </div>
            <div class="ol-stat-sub">{{ 'Per order lifecycle'|t('order-lifecycle') }}</div>
        </div>

        <div class="ol-stat-card">
            <div class="ol-stat-label">{{ 'Conversion Rate'|t('order-lifecycle') }}</div>
            <div class="ol-stat-value-row">
                <span class="ol-stat-value">{{ stats.conversionRate }}%</span>
                {{ macros.trend(stats.trends.conversionRate ?? null, true) }}
            </div>
            <div class="ol-stat-sub">
                {{ '{completed} of {created} carts'|t('order-lifecycle', {
                    completed: stats.ordersCompleted,
                    created: stats.cartsCreated
                }) }}
            </div>
        </div>

        <div class="ol-stat-card">
            <div class="ol-stat-label">{{ 'Avg. Time to Complete'|t('order-lifecycle') }}</div>
            <div class="ol-stat-value-row">
                <span class="ol-stat-value">{{ stats.avgTimeToCompletion ?: '-' }}</span>
            </div>
            <div class="ol-stat-sub">{{ 'From cart to order'|t('order-lifecycle') }}</div>
        </div>

        <div class="ol-stat-card">
            <div class="ol-stat-label">{{ 'Avg. Checkout Time'|t('order-lifecycle') }}</div>
            <div class="ol-stat-value-row">
                <span class="ol-stat-value">{{ stats.avgCheckoutDuration ?: '-' }}</span>
            </div>
            <div class="ol-stat-sub">{{ 'From start to payment'|t('order-lifecycle') }}</div>
        </div>

        <div class="ol-stat-card">
            <div class="ol-stat-label">{{ 'Abandonment Rate'|t('order-lifecycle') }}</div>
            <div class="ol-stat-value-row">
                <span class="ol-stat-value">{{ stats.abandonmentRate }}%</span>
                {{ macros.trend(stats.trends.abandonmentRate ?? null, false) }}
            </div>
            <div class="ol-stat-sub">{{ '{count} abandoned carts'|t('order-lifecycle', {count: stats.abandonedCarts}) }}</div>
        </div>

        <div class="ol-stat-card">
            <div class="ol-stat-label">{{ 'Avg. Payment Retries'|t('order-lifecycle') }}</div>
            <div class="ol-stat-value-row">
                <span class="ol-stat-value">{{ stats.avgPaymentAttempts ?: '-' }}</span>
            </div>
            <div class="ol-stat-sub">{{ 'Per completed order'|t('order-lifecycle') }}</div>
        </div>

        <div class="ol-stat-card">
            <div class="ol-stat-label">{{ 'Returning Customers'|t('order-lifecycle') }}</div>
            <div class="ol-stat-value-row">
                <span class="ol-stat-value">{{ stats.returningCustomerRate }}%</span>
            </div>
            <div class="ol-stat-sub">{{ 'Of completed orders'|t('order-lifecycle') }}</div>
        </div>

        {% if stats.avgCartValue %}
            <div class="ol-stat-card">
                <div class="ol-stat-label">{{ 'Avg. Cart Value'|t('order-lifecycle') }}</div>
                <div class="ol-stat-value-row">
                    <span class="ol-stat-value">{{ stats.avgCartValue|currency }}</span>
                </div>
                <div class="ol-stat-sub">{{ 'For completed orders'|t('order-lifecycle') }}</div>
            </div>
        {% endif %}

        {% if stats.emailsSent or stats.emailsFailed %}
            <div class="ol-stat-card">
                <div class="ol-stat-label">{{ 'Email Success Rate'|t('order-lifecycle') }}</div>
                <div class="ol-stat-value-row">
                    <span class="ol-stat-value">{{ stats.emailSuccessRate }}%</span>
                    {{ macros.trend(stats.trends.emailSuccessRate ?? null, true) }}
                </div>
                <div class="ol-stat-sub">
                    {{ '{sent} sent, {failed} failed'|t('order-lifecycle', {
                        sent: stats.emailsSent,
                        failed: stats.emailsFailed
                    }) }}
                </div>
            </div>
        {% endif %}

    </div>

    {% if stats.topEventTypes|length > 0 %}
        <div class="ol-events-list">
            <div class="ol-events-title">{{ 'Top Events'|t('order-lifecycle') }}</div>
            {% for event in stats.topEventTypes %}
                <div class="ol-event-item">
                    <span class="ol-event-name">{{ event.type }}</span>
                    <span class="ol-event-count">{{ event.count|number_format }}</span>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="ol-period-note">
        {% if stats.days == 0 %}
            {{ 'All time statistics'|t('order-lifecycle') }}
        {% else %}
            {{ 'Statistics for the last {days} days'|t('order-lifecycle', {days: stats.days}) }}
        {% endif %}
        &mdash; {{ 'includes carts currently in progress'|t('order-lifecycle') }}
        {% if stats.trends is not empty %}
            &mdash; {{ 'trend vs prior {days} days'|t('order-lifecycle', {days: stats.days}) }}
        {% endif %}
    </div>

</div>
{% endblock %}
