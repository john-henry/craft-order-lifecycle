{% extends '_layouts/cp' %}

{% set selectedSubnavItem = 'overview' %}
{% set title = 'Overview'|t('order-lifecycle') %}
{% set crumbs = [
    { label: 'Order Lifecycle'|t('order-lifecycle'), url: cpUrl('order-lifecycle') }
] %}

{% do view.registerAssetBundle('johnhenry\\orderlifecycle\\assets\\OrderLifecycleAsset') %}

{% block actionButton %}
<form method="get" action="{{ cpUrl('order-lifecycle') }}">
    <div class="btngroup">
        {% for d in [7, 14, 30, 60, 90] %}
            <button type="submit" name="days" value="{{ d }}" class="btn{% if days == d %} active{% endif %}">
                {{ d ~ ' ' ~ 'days'|t('order-lifecycle') }}
            </button>
        {% endfor %}
        <button type="submit" name="days" value="0" class="btn{% if days == 0 %} active{% endif %}">
            {{ 'All time'|t('order-lifecycle') }}
        </button>
    </div>
</form>
{% endblock %}

{% block content %}
<div class="order-lifecycle-dashboard">

    {# ── Alert banners ─────────────────────────────────────────────────────── #}
    {% set alerts = [] %}

    {% if stats.uniqueOrders == 0 and stats.days > 0 %}
        {% set alerts = alerts|merge([{
            level: 'warning',
            icon: '⚠',
            message: 'No orders tracked in this period. Lifecycle logging may not be active.'|t('order-lifecycle')
        }]) %}
    {% endif %}

    {% if stats.abandonmentRate > 75 and stats.cartsCreated >= 5 %}
        {% set alerts = alerts|merge([{
            level: 'warning',
            icon: '⚠',
            message: 'Abandonment rate is {rate}% - above the 75% threshold. Consider reviewing the checkout flow.'|t('order-lifecycle', {rate: stats.abandonmentRate})
        }]) %}
    {% endif %}

    {% if (stats.emailsSent + stats.emailsFailed) >= 5 and stats.emailSuccessRate < 90 %}
        {% set alerts = alerts|merge([{
            level: 'danger',
            icon: '⚠',
            message: 'Email success rate is {rate}% ({failed} failed). Check your email provider configuration.'|t('order-lifecycle', {rate: stats.emailSuccessRate, failed: stats.emailsFailed})
        }]) %}
    {% endif %}

    {% if stats.avgPaymentAttempts > 2 and stats.ordersCompleted >= 5 %}
        {% set alerts = alerts|merge([{
            level: 'warning',
            icon: '⚠',
            message: 'Customers are averaging {n} payment retries on failed orders. Check your payment gateway.'|t('order-lifecycle', {n: stats.avgPaymentAttempts})
        }]) %}
    {% endif %}

    {% if alerts|length > 0 %}
        <div class="ol-alerts">
            {% for alert in alerts %}
                <div class="ol-alert ol-alert-{{ alert.level }}">
                    <span class="ol-alert-icon">{{ alert.icon }}</span>
                    <span>{{ alert.message }}</span>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {# ── Stat grid ─────────────────────────────────────────────────────────── #}
    {% include 'order-lifecycle/_includes/stat-grid' with {
        stats: stats,
        showAllTimeNote: true,
    } only %}

</div>
{% endblock %}
