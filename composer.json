{
  "name": "johnhenry/craft-order-lifecycle",
  "description": "Order Lifecycle logs and timeline for Craft Commerce",
  "type": "craft-plugin",
  "version": "1.0.0-beta.1",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-commerce",
    "craft-plugin"
  ],
  "license": "proprietary",
  "authors": [
    {
      "name": "John Henry",
      "homepage": "https://johnhenry.ie"
    }
  ],
  "homepage": "https://plugins.johnhenry.ie/order-lifecycle",
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4",
    "craftcms/cms": "^5.0",
    "craftcms/commerce": "^5.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "johnhenry\\orderlifecycle\\": "src/"
    }
  },
  "scripts": {
    "phpstan": "phpstan --ansi --memory-limit=1G",
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --fix --ansi"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true,
      "yiisoft/yii2-composer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "support": {
    "docs": "https://plugins.johnhenry.ie/order-lifecycle",
    "source": "https://github.com/john-henry/craft-order-lifecycle",
    "issues": "https://github.com/john-henry/craft-order-lifecycle/issues"
  },
  "extra": {
    "name": "Order Lifecycle",
    "handle": "order-lifecycle",
    "developer": "John Henry",
    "developerUrl": "https://johnhenry.ie",
    "documentationUrl": "https://plugins.johnhenry.ie/order-lifecycle/",
    "changelogUrl": "https://github.com/john-henry/craft-order-lifecycle/blob/craft-5-beta/CHANGELOG.md",
    "class": "johnhenry\\orderlifecycle\\OrderLifecycle"
  }
}
