{
  "name": "johnhenry/craft-order-lifecycle",
  "description": "A timeline of every step each Craft Commerce order took, with store analytics and optional AI insights.",
  "type": "craft-plugin",
  "version": "2.0.1",
  "keywords": [
    "craft-commerce",
    "order history",
    "order timeline",
    "audit log",
    "abandoned carts",
    "cart abandonment",
    "checkout analytics",
    "conversion rate",
    "failed payments",
    "refunds",
    "customer support",
    "order export"
  ],
  "license": "proprietary",
  "authors": [
    {
      "name": "John Henry",
      "homepage": "https://johnhenry.ie"
    }
  ],
  "homepage": "https://johnhenry.ie/plugins/order-lifecycle/",
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4",
    "craftcms/cms": "^5.0",
    "craftcms/commerce": "^5.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "johnhenry\\orderlifecycle\\": "src/"
    }
  },
  "scripts": {
    "phpstan": "phpstan --ansi --memory-limit=1G",
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --fix --ansi"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true,
      "yiisoft/yii2-composer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "support": {
    "docs": "https://johnhenry.ie/plugins/order-lifecycle/",
    "source": "https://github.com/john-henry/craft-order-lifecycle",
    "issues": "https://github.com/john-henry/craft-order-lifecycle/issues"
  },
  "extra": {
    "name": "Order Lifecycle",
    "handle": "order-lifecycle",
    "developer": "John Henry",
    "developerUrl": "https://johnhenry.ie",
    "documentationUrl": "https://johnhenry.ie/plugins/order-lifecycle/",
    "changelogUrl": "https://github.com/john-henry/craft-order-lifecycle/blob/craft-5/CHANGELOG.md",
    "class": "johnhenry\\orderlifecycle\\OrderLifecycle"
  }
}
